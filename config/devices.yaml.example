# Device Groups Configuration
# Copy this file to devices.yaml and fill in your real MAC addresses
# devices.yaml is gitignored and never committed
#
# Default-deny: a device reaches the internet only if its group is `protected`, `always_on`, or
# switched on in the web UI (the switches are kept in config/group_state.json). Everything else,
# listed or not, is dropped.

groups:
  essential:
    description: "Devices that get internet when you switch the group on"
    devices:
      - name: "example_phone"
        mac: "AA:BB:CC:DD:EE:01"
        description: "Example phone"

  security:
    description: "Security cameras and monitoring devices"
    always_on: true   # always has internet and has no switch: the panel and the API cannot turn it off
    devices:
      - name: "example_camera"
        mac: "AA:BB:CC:DD:EE:02"
        description: "Example camera"

  media:
    description: "Entertainment devices"
    devices:
      - name: "example_tv"
        mac: "AA:BB:CC:DD:EE:03"
        description: "Example smart TV"

  infrastructure:
    description: "Network infrastructure - NEVER BLOCKED"
    protected: true
    devices:
      - name: "example_gateway"
        mac: "AA:BB:CC:DD:EE:F1"
        description: "Gateway LAN interface"

  kids:
    description: "Unknown or unregistered devices"
    auto_detect: true
    devices: []
