# Network Configuration
WAN_INTERFACE=ppp0
LAN_INTERFACE=enp5s0
# Input interfaces that always reach the internet (comma-separated), for clients that have no
# MAC of their own: WireGuard in a container arrives on the Docker bridge, usually docker0
ALLOW_INTERFACES=

# Application Settings
DRY_RUN=true
API_PORT=8002
UI_PORT=3002

# Security (CHANGE THESE!)
JWT_SECRET=your-super-secret-jwt-key-change-this
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Logging
LOG_LEVEL=INFO
